# ---------------------------------------------------------------------------
# Vitrin — ortam değişkenleri
# Yerelde: bu dosyayı .env.local adıyla kopyalayıp doldurun.
# Vercel'de: Project → Settings → Environment Variables bölümüne aynı adlarla girin.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API (Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon" (ya da yeni adıyla "publishable") anahtar — herkese açık olabilir, RLS korur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" (ya da yeni adıyla "secret") anahtar — GİZLİ! Yalnızca sunucuda kullanılır,
# başına asla NEXT_PUBLIC_ eklemeyin.
SUPABASE_SERVICE_ROLE_KEY=

# Veritabanı bağlantı adresi: tablolar her yayında (pnpm build) otomatik kurulur.
# Vercel'in Supabase bağlantısı POSTGRES_URL_NON_POOLING değişkenini kendisi ekler.
# Supabase'i ayrıca açtıysan: Project Settings → Database → Connection string (Session pooler).
SUPABASE_DB_URL=

# Ablanın panel hesabı (yayın sırasında açılır). ADMIN_PASSWORD yalnızca ilk şifredir:
# hesap varsa şifresi değiştirilmez; açıldıktan sonra bu değişkeni silebilirsin. Ör. ADMIN_USERNAME=shopbysac
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tekil ziyaretçi sayımı için IP özetinde kullanılan gizli tuz (IP saklanmaz).
# Rastgele uzun bir metin üretin, ör.: openssl rand -hex 32
IP_HASH_SALT=

# Sitenin kalıcı adresi (paylaşım önizlemeleri, "şifremi unuttum" e-postası). Sonunda / olmasın.
# Boş bırakılırsa Vercel'deki kalıcı adres kullanılır.
NEXT_PUBLIC_SITE_URL=

# Vitrinin kimliği
NEXT_PUBLIC_SITE_NAME=Shopbysac
NEXT_PUBLIC_SITE_TAGLINE=Hikâyelerimde paylaştığım parçalar kaybolmasın diye hepsi burada.
NEXT_PUBLIC_INSTAGRAM_USERNAME=shopbysac2
# Profil fotoğrafı panelden (Hesabım) yüklenir. Bu değişken yalnızca yedek:
# public/ altındaki dosya (ör. /profil.jpg) ya da tam URL. İkisi de yoksa adın baş harfi gösterilir.
NEXT_PUBLIC_PROFILE_IMAGE=
# Gizlilik metnindeki iletişim adresi (boşsa Instagram linki gösterilir).
NEXT_PUBLIC_CONTACT_EMAIL=

# Günlük link sağlık kontrolü (vercel.json → crons). Vercel bu değeri isteğe ekler;
# tanımlı değilse kontrol çalışmaz. Rastgele uzun bir metin: openssl rand -hex 24
CRON_SECRET=

# "Şifremi unuttum" e-postası kendi e-posta hesabından gitsin (Supabase'in hazır servisi
# yalnızca proje ekibindeki adreslere gönderir). Boş bırakılırsa Supabase'in servisi kullanılır.
# iCloud: smtp.mail.me.com · 587 · kullanıcı = iCloud adresi · şifre = appleid.apple.com'dan
#         "uygulamaya özel şifre"  ·  Gmail: smtp.gmail.com · 465 · Google "uygulama şifresi"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gönderen: SMTP hesabıyla aynı adres olmalı. Ör. Shopbysac <ornek@icloud.com>
SMTP_FROM=
